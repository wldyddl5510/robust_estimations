# Only code, tests, and documentation are tracked; experiment outputs stay local.

# Python and OS
__pycache__/
*.pyc
*.pyo
.DS_Store

# Experiments run before the October 2026 refactor (kept locally only)
previous_experiments/

# New experiment outputs; results.md itself is tracked (figures: see the end of this file)
results/**
logs/

# Generated records, figures, data, and run state anywhere
*.json
*.csv
*.png
*.pdf
*.svg
*.npz
*.npy
*.pkl
*.log
*.lock
*.tmp
*.pid

# Figures shown in results.md stay tracked so that it renders on GitHub
!results/**/
!results/**/*.png
